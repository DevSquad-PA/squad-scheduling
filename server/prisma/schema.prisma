generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @map("id_user") @db.Uuid
  firstName     String?        @map("first_name") @db.VarChar(255)
  lastName      String?        @map("last_name") @db.VarChar(255)
  image         String?        @map("photo_url")
  phone         String?        @db.VarChar(50)
  secondPhone   String?        @map("second_phone") @db.VarChar(50)
  email         String         @unique @db.VarChar(255)
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  name          String?        @db.VarChar
  emailVerified Boolean        @default(false) @map("email_verified")
  updatedAt     DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cpf           String?        @db.VarChar(20)
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date
  auditLogs     AuditLog[]
  professionals Professional[]
  accounts      Account[]
  clinicMembers ClinicMember[]
  sessions      Session[]

  @@map("usr_users")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("usr_sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  idToken               String?   @map("id_token")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("usr_accounts")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("usr_verifications")
}

model Clinic {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @map("id_clinic") @db.Uuid
  name          String         @db.VarChar(255)
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  professionals Professional[]
  patients      Patient[]
  appointments  Appointment[]
  members       ClinicMember[]

  @@map("org_clinics")
}

model Role {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @map("id_role") @db.Uuid
  description String         @unique @db.VarChar(50)
  createdAt   DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  members     ClinicMember[]

  @@map("usr_roles")
}

model ClinicMember {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @map("id_member") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  clinicId  String?   @map("clinic_id") @db.Uuid
  roleId    String?   @map("role_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  clinic    Clinic?   @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("usr_clinic_members")
}

model Professional {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @map("id_professional") @db.Uuid
  userId       String?       @map("user_id") @db.Uuid
  clinicId     String?       @map("clinic_id") @db.Uuid
  specialty    String?       @map("speciality") @db.VarChar(255)
  services     String[]
  createdAt    DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  clinic       Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments Appointment[]

  @@map("med_professionals")
}

model Patient {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @map("id_patient") @db.Uuid
  clinicId     String?       @map("clinic_id") @db.Uuid
  createdAt    DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  clinic       Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments Appointment[]

  @@map("pat_patients")
}

model Appointment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @map("id_appointment") @db.Uuid
  clinicId       String?       @map("clinic_id") @db.Uuid
  professionalId String?       @map("professional_id") @db.Uuid
  patientId      String?       @map("patient_id") @db.Uuid
  date           DateTime      @map("appointment_date") @db.Date
  time           DateTime      @map("appointment_time") @db.Time(6)
  services       String[]
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  value          Int?
  clinic         Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient        Patient?      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sch_appointments")
}

model AuditLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @map("id_log") @db.Uuid
  tableName String    @map("table_name") @db.VarChar(50)
  recordId  String    @map("record_id") @db.Uuid
  action    String    @db.VarChar(20)
  oldData   Json?     @map("old_data")
  newData   Json?     @map("new_data")
  changedBy String?   @map("changed_by") @db.Uuid
  changedAt DateTime? @default(now()) @map("changed_at") @db.Timestamptz(6)
  user      User?     @relation(fields: [changedBy], references: [id], onUpdate: NoAction)

  @@map("aud_logs")
}
